#!/bin/bash
# Local candidates now enter the initial edition installation. Verify the exact
# selected payload metadata instead of reinstalling every package and rerunning
# its triggers. The later cleanup hook removes the build-local repository.
set -euo pipefail
if [[ -f /opt/foundry-local-apt/manifest.json ]]; then
    python3 /opt/foundry-local-apt/verify.py --verify
fi
