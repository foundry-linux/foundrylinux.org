+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "powerdevilcore.h"
+#include "PowerDevilGlobalSettings.h"
+#include <KNotification>
+#include <QStandardPaths>
+#include <QTest>
+#include <QTimer>
+
+namespace PowerDevil
+{
+class BatteryNotificationsTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void initTestCase()
+    {
+        QStandardPaths::setTestModeEnabled(true);
+    }
+
+    void recoveringCharge_data()
+    {
+        QTest::addColumn<int>("previous");
+        QTest::addColumn<int>("current");
+        QTest::addColumn<int>("otherBattery");
+        QTest::addColumn<bool>("critical");
+        QTest::addColumn<bool>("remains");
+        QTest::newRow("low-percentage-updates") << 7 << 9 << 0 << false << true;
+        QTest::newRow("low-boundary") << 9 << 10 << 0 << false << true;
+        QTest::newRow("low-recovered") << 9 << 12 << 0 << false << false;
+        QTest::newRow("charged-during-suspend") << 9 << 80 << 0 << false << false;
+        QTest::newRow("critical-percentage-updates") << 2 << 4 << 0 << true << true;
+        QTest::newRow("critical-boundary") << 4 << 5 << 0 << true << true;
+        QTest::newRow("critical-recovered-still-low") << 4 << 6 << 0 << true << false;
+        QTest::newRow("aggregate-charge-recovers") << 4 << 6 << 5 << false << false;
+    }
+
+    void recoveringCharge()
+    {
+        QFETCH(int, previous);
+        QFETCH(int, current);
+        QFETCH(int, otherBattery);
+        QFETCH(bool, critical);
+        QFETCH(bool, remains);
+        Core core(nullptr);
+        core.m_globalSettings = new GlobalSettings(false, false, &core);
+        core.m_globalSettings->setBatteryLowLevel(10);
+        core.m_globalSettings->setBatteryCriticalLevel(5);
+        core.m_batteriesPercent.insert(QStringLiteral("battery"), previous);
+        core.m_batteriesPercent.insert(QStringLiteral("other"), otherBattery);
+        auto &notification = critical ? core.m_criticalBatteryNotification : core.m_lowBatteryNotification;
+        notification = new KNotification(QStringLiteral("test"), KNotification::Persistent, &core);
+        if (critical) {
+            core.m_criticalBatteryTimer->start(60000);
+        }
+        // Exercise the real signal handler without an AC plug/unplug event.
+        core.onBatteryChargePercentChanged(current, QStringLiteral("battery"));
+        QCOMPARE(core.currentChargePercent(), current + otherBattery);
+        QCOMPARE(!notification.isNull(), remains);
+        if (remains) {
+            QVERIFY(notification->title().contains(QString::number(current + otherBattery)));
+        }
+        if (critical) {
+            QCOMPARE(core.m_criticalBatteryTimer->isActive(), remains);
+        }
+    }
+
+    void recoveryCancelsTimerAfterNotificationDismissed()
+    {
+        Core core(nullptr);
+        core.m_globalSettings = new GlobalSettings(false, false, &core);
+        core.m_globalSettings->setBatteryCriticalLevel(5);
+        core.m_batteriesPercent.insert(QStringLiteral("battery"), 4);
+        core.m_criticalBatteryTimer->start(60000);
+        core.onBatteryChargePercentChanged(6, QStringLiteral("battery"));
+        QVERIFY(!core.m_criticalBatteryTimer->isActive());
+    }
+
+    void peripheralRecoveryDoesNotClearLaptopWarning()
+    {
+        Core core(nullptr);
+        core.m_batteriesPercent.insert(QStringLiteral("battery"), 4);
+        core.m_peripheralBatteriesPercent.insert(QStringLiteral("mouse"), 4);
+        core.m_criticalBatteryNotification = new KNotification(QStringLiteral("test"), KNotification::Persistent, &core);
+        core.m_criticalBatteryTimer->start(60000);
+        core.onBatteryChargePercentChanged(80, QStringLiteral("mouse"));
+        QCOMPARE(core.currentChargePercent(), 4);
+        QVERIFY(core.m_criticalBatteryNotification);
+        QVERIFY(core.m_criticalBatteryTimer->isActive());
+    }
+};
+}
+
+QTEST_MAIN(PowerDevil::BatteryNotificationsTest)
+#include "batterynotificationstest.moc"
