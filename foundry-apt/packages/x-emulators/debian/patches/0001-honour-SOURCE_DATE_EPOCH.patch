Description: honour SOURCE_DATE_EPOCH for the embedded build date
 The build embeds a timestamp (build/objs/cdate.data) taken from `git log`,
 falling back to the current date when the source is not a git checkout — as
 is the case for any release tarball or distribution package. That makes the
 resulting binaries unreproducible: two builds of identical source produce
 different output.
 .
 Prefer SOURCE_DATE_EPOCH when it is set (the cross-distribution convention,
 https://reproducible-builds.org/specs/source-date-epoch/), keeping the
 existing git and date fallbacks untouched for normal developer builds.
Author: Foundry Linux <packages@foundrylinux.org>
Forwarded: not-yet
Last-Update: 2026-08-05
---
--- a/build/Makefile.common
+++ b/build/Makefile.common
@@ -172,7 +172,7 @@
 	@echo "const char XEMU_BUILDINFO_AT[]  = \"`date`\";" >> $(DEPFILEPREFIX)-buildinfo.c
 	@echo "const char XEMU_BUILDINFO_GIT[] = \"`bash $(TOPDIR)/build/show-git-info`\";" >> $(DEPFILEPREFIX)-buildinfo.c
 	@echo "const char XEMU_BUILDINFO_TARGET[] = \"$(PRG_TARGET) ($(PRG)) for $(TARGET) on \" XEMU_ARCH_NAME \" ($(ARCH)) using $(CONFIG_CC)\";" >> $(DEPFILEPREFIX)-buildinfo.c
-	@git log -1 --format=%cd --date=format:%Y%m%d%H%M%S > $(TOPDIR)/build/objs/cdate.data || date '+%Y%m%d%H%M%S' > $(TOPDIR)/build/objs/cdate.data
+	@if [ -n "$(SOURCE_DATE_EPOCH)" ]; then date -u -d "@$(SOURCE_DATE_EPOCH)" '+%Y%m%d%H%M%S' > $(TOPDIR)/build/objs/cdate.data; else git log -1 --format=%cd --date=format:%Y%m%d%H%M%S > $(TOPDIR)/build/objs/cdate.data || date '+%Y%m%d%H%M%S' > $(TOPDIR)/build/objs/cdate.data; fi
 	@echo "$(PROGRESS_MARKER_START)Commit date we're building ($(TOPDIR)/build/objs/cdate.data): `cat $(TOPDIR)/build/objs/cdate.data`$(PROGRESS_MARKER_END)"
 	@echo "const char XEMU_BUILDINFO_CDATE[] = \"`cat $(TOPDIR)/build/objs/cdate.data`\";" >> $(DEPFILEPREFIX)-buildinfo.c
 	@$(ECHO_BIN) -n "$(PROGRESS_MARKER_START)COMPILING: $(DEPFILEPREFIX)-buildinfo.c$(PROGRESS_MARKER_END)" 2>/dev/null || true
